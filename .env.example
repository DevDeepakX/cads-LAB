# Copy this file to .env and fill in your actual API keys
# DO NOT commit the actual .env file to git!

# ─────────────────────────────────────────────────────────────────────────────
# Groq API Key (https://console.groq.com/keys)
# Groq provides FREE ultra-fast LLM inference (Llama 3, Mixtral, Gemma)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Optional: Override the default Groq model
# Options:
#   llama-3.3-70b-versatile   ← default (best quality, fast)
#   llama3-8b-8192            ← fastest, good for simple Q&A
#   mixtral-8x7b-32768        ← large context window
#   gemma2-9b-it              ← Google Gemma 2
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────────
# Flask Secret Key (for sessions)
FLASK_SECRET_KEY=your-secret-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Optional for debugging
DEBUG=False
